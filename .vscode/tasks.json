{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "bear_make",
            "type": "shell",
            "command": "bear -- make clean && bear -- make -j$(nproc)",
            "options": {
                "cwd": "${workspaceFolder}/examples/example_sdl3_vulkan",
                "env": {
                    "PATH": "/home/joao/miniconda3/envs/imgui-cpp/bin:/usr/local/bin:/usr/bin:/bin"
                }
            },
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "make: example_sdl3_vulkan",
            "type": "shell",
            "command": "make -j$(nproc)",
            "options": {
                "cwd": "${workspaceFolder}/examples/example_sdl3_vulkan",
                "env": {
                    "PATH": "/home/joao/miniconda3/envs/imgui-cpp/bin:/usr/local/bin:/usr/bin:/bin"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },

        // ── Debug log tail ───────────────────────────────────────────────────
        {
            "label": "tail: debug log",
            "type": "shell",
            "command": "tail -f /tmp/imgui_debug.log",
            "isBackground": true,
            "problemMatcher": {
                "owner": "tail-debug-log",
                "pattern": { "regexp": "x^" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "x^"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            }
        },

        // ── Compound: build + start tail in parallel ─────────────────────────
        {
            "label": "build + tail debug log",
            "dependsOn": ["make: example_sdl3_vulkan", "tail: debug log"],
            "dependsOrder": "parallel"
        },

        // ── CMake tasks ──────────────────────────────────────────────────────────
        {
            "label": "cmake: configure",
            "type": "shell",
            "command": "cmake --preset linux-debug",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "/home/joao/miniconda3/envs/imgui-cpp/bin:/usr/local/bin:/usr/bin:/bin"
                }
            },
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "cmake: build (debug)",
            "type": "shell",
            "command": "cmake --build --preset linux-debug --parallel $(nproc)",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "/home/joao/miniconda3/envs/imgui-cpp/bin:/usr/local/bin:/usr/bin:/bin"
                }
            },
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "cmake: clean",
            "type": "shell",
            "command": "cmake --build --preset linux-debug --target clean",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "/home/joao/miniconda3/envs/imgui-cpp/bin:/usr/local/bin:/usr/bin:/bin"
                }
            },
            "group": "build",
            "problemMatcher": []
        },

        // ── CMake compound: build + tail ─────────────────────────────────────────
        {
            "label": "cmake: build + tail debug log",
            "dependsOn": ["cmake: build (debug)", "tail: debug log"],
            "dependsOrder": "parallel"
        }
    ]
}
